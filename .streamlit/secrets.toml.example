# ─────────────────────────────────────────────────────────────────────────────
# Modèle de secrets — NE PAS committer le vrai fichier secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# En LOCAL   : copiez ce fichier en .streamlit/secrets.toml et renseignez-le.
# Sur STREAMLIT CLOUD : n'utilisez PAS de fichier ; collez ces valeurs dans
#   « Manage app » → Settings → Secrets. Rien n'est exposé dans le code / GitHub.
# ─────────────────────────────────────────────────────────────────────────────

[pmis]
# Points de terminaison PMIS
auth_url    = "https://PMIS_IP/pmisAuthServer/api"   # /login et /refresh
backend_url = "https://PMIS_IP/pmisBackend/api"      # /visits

# Identifiants (utilisez username OU mail, plus password)
username    = "mon_utilisateur"
# mail      = "user@exemple.ma"
password    = "CHANGE_ME"

# Options
verify_ssl  = true      # mettez false uniquement si le certificat PMIS est auto-signé
timeout     = 60
