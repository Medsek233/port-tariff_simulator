# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement PMIS (repli si les secrets Streamlit ne sont pas
# utilisés). Copiez en .env pour un usage local — NE PAS committer le vrai .env.
# Sur Streamlit Cloud, préférez Settings → Secrets (voir secrets.toml.example).
# ─────────────────────────────────────────────────────────────────────────────
PMIS_AUTH_URL=https://PMIS_IP/pmisAuthServer/api
PMIS_BACKEND_URL=https://PMIS_IP/pmisBackend/api
PMIS_USERNAME=mon_utilisateur
# PMIS_MAIL=user@exemple.ma
PMIS_PASSWORD=CHANGE_ME
PMIS_VERIFY_SSL=true
PMIS_TIMEOUT=60
